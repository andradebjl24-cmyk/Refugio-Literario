@model Biblioteca.Models.Categoria

@{
    ViewData["Title"] = "Criar Categoria";
}

<div class="container py-4">
    <h1>Criar Categoria</h1>
    <p class="text-muted">
        Cadastre uma categoria principal ou uma subcategoria.
    </p>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">
                Nome da categoria
            </label>

            <input asp-for="Nome"
                   class="form-control"
                   placeholder="Ex.: Fantasia" />

            <span asp-validation-for="Nome"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoriaPaiId" class="form-label">
                Categoria principal
            </label>

            <select asp-for="CategoriaPaiId"
                    asp-items="ViewBag.CategoriasPai"
                    class="form-select">
                <option value="">Nenhuma (categoria principal)</option>
            </select>

            <span asp-validation-for="CategoriaPaiId"
                  class="text-danger"></span>

            <small class="form-text text-muted">
                Deixe como "Nenhuma" para criar uma categoria principal.
                Escolha outra categoria para criar uma subcategoria.
            </small>
        </div>

        <div class="form-check mb-4">
            <input asp-for="ExibirNaHome"
                   class="form-check-input" />

            <label asp-for="ExibirNaHome"
                   class="form-check-label">
                Exibir nos destaques da página inicial
            </label>

            <span asp-validation-for="ExibirNaHome"
                  class="text-danger d-block"></span>

            <small class="form-text text-muted">
                Essa opção é permitida somente para categorias principais.
            </small>
        </div>

        <button type="submit" class="btn btn-primary">
            Salvar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Voltar
        </a>
    </form>
</div>

