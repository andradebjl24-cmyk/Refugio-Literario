@model Biblioteca.Models.Categoria

@{
    ViewData["Title"] = "Editar categoria";
}

<div class="admin-dashboard">

    <div class="admin-cabecalho mb-4">
        <div>
            <h1>Editar categoria</h1>
        </div>

        <div class="admin-cabecalho-icone">
            <i class="bi bi-tags-fill"></i>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label">
                        Nome da categoria
                    </label>

                    <input asp-for="Nome" class="form-control" />

                    <span asp-validation-for="Nome"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoriaPaiId" class="form-label">
                        Categoria principal
                    </label>

                    <select asp-for="CategoriaPaiId"
                            asp-items="ViewBag.CategoriasPai"
                            class="form-select">
                        <option value="">Nenhuma (categoria principal)</option>
                    </select>

                    <span asp-validation-for="CategoriaPaiId"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="ExibirNaHome"
                           class="form-check-input" />

                    <label asp-for="ExibirNaHome"
                           class="form-check-label">
                        Exibir na página inicial
                    </label>

                    <span asp-validation-for="ExibirNaHome"
                          class="text-danger d-block"></span>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>
                        Salvar alterações
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Voltar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
