@model IEnumerable<Biblioteca.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
    var categorias = Model?.ToList() ?? new List<Biblioteca.Models.Categoria>();
}

<div class="admin-dashboard admin-categorias">

    <!-- CABEÇALHO -->
    <div class="admin-cabecalho d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="mb-1">Categorias</h1>
            <p class="text-muted mb-0">
                Organize os livros por categorias e subcategorias.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i>
            Nova categoria
        </a>
    </div>

    <!-- MENSAGENS -->
    @if (TempData["Mensagem"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Mensagem"]

            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Erro"]

            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <!-- RESUMO -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="h5 mb-1">Lista de categorias</h2>
            <p class="text-muted mb-0">
                Consulte e gerencie as categorias do acervo.
            </p>
        </div>

        <span class="text-muted small">
            <i class="bi bi-tags me-1"></i>
            Total: <strong>@categorias.Count</strong>
        </span>
    </div>

    <!-- LISTAGEM -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">

            @if (categorias.Any())
            {
                <!-- TABELA: DESKTOP -->
                <div class="table-responsive admin-categorias-desktop">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Nome</th>
                                <th>Tipo</th>
                                <th>Página inicial</th>
                                <th class="text-end pe-4">Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in categorias)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (item.CategoriaPaiId.HasValue)
                                            {
                                                <i class="bi bi-arrow-return-right text-muted"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-folder2-open text-success"></i>
                                            }

                                            <span class="fw-semibold">
                                                @item.Nome
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        @if (item.CategoriaPaiId.HasValue)
                                        {
                                            <span class="badge bg-secondary">Subcategoria</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Principal</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.CategoriaPaiId.HasValue)
                                        {
                                            <span class="text-muted">Não se aplica</span>
                                        }
                                        else if (item.ExibirNaHome)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>Sim
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Não</span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end flex-wrap gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="Ver detalhes">
                                                <i class="bi bi-eye"></i>
                                                <span class="d-none d-lg-inline">Detalhes</span>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-success"
                                               title="Editar categoria">
                                                <i class="bi bi-pencil-square"></i>
                                                <span class="d-none d-lg-inline">Editar</span>
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Excluir categoria">
                                                <i class="bi bi-trash"></i>
                                                <span class="d-none d-lg-inline">Excluir</span>
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

                <!-- CARDS: MOBILE -->
                <div class="admin-categorias-mobile p-3">
                    <div class="d-flex flex-column gap-3">

                        @foreach (var item in categorias)
                        {
                            <article class="card admin-categoria-card border shadow-sm">
                                <div class="card-body">

                                    <div class="d-flex align-items-start gap-3 mb-3">
                                        <div class="rounded-circle bg-light text-success d-flex align-items-center justify-content-center"
                                             style="width: 46px; height: 46px; flex-shrink: 0;">
                                            @if (item.CategoriaPaiId.HasValue)
                                            {
                                                <i class="bi bi-arrow-return-right fs-5"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-folder2-open fs-5"></i>
                                            }
                                        </div>

                                        <div class="flex-grow-1 min-w-0">
                                            <span class="text-muted small d-block">
                                                Nome da categoria
                                            </span>
                                            <h3 class="h6 fw-bold mb-2 text-break">
                                                @item.Nome
                                            </h3>

                                            @if (item.CategoriaPaiId.HasValue)
                                            {
                                                <span class="badge bg-secondary">Subcategoria</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Principal</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="rounded bg-light p-3 mb-3">
                                        <span class="text-muted small d-block mb-1">
                                            Exibição na página inicial
                                        </span>

                                        @if (item.CategoriaPaiId.HasValue)
                                        {
                                            <span class="text-muted">Não se aplica</span>
                                        }
                                        else if (item.ExibirNaHome)
                                        {
                                            <span class="text-success fw-semibold">
                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                Sim
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                <i class="bi bi-dash-circle me-1"></i>
                                                Não
                                            </span>
                                        }
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary flex-grow-1">
                                            <i class="bi bi-eye me-1"></i>
                                            Detalhes
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-success flex-grow-1">
                                            <i class="bi bi-pencil-square me-1"></i>
                                            Editar
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger flex-grow-1">
                                            <i class="bi bi-trash me-1"></i>
                                            Excluir
                                        </a>

                                    </div>

                                </div>
                            </article>
                        }

                    </div>
                </div>
            }
            else
            {
                <!-- ESTADO VAZIO -->
                <div class="text-center py-5 px-3">
                    <i class="bi bi-tags display-4 text-muted"></i>

                    <h3 class="h5 mt-3 mb-2">
                        Nenhuma categoria cadastrada
                    </h3>

                    <p class="text-muted mb-3">
                        Crie uma categoria para começar a organizar o acervo.
                    </p>

                    <a asp-action="Create" class="btn btn-success">
                        <i class="bi bi-plus-circle me-1"></i>
                        Nova categoria
                    </a>
                </div>
            }

        </div>
    </div>

</div>
