
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Refúgio Literário</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/biblioteca.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
   <nav class="navbar navbar-expand-lg navbar-dark admin-navbar mb-4">
        <div class="container">

            <button class="navbar-toggler ms-auto"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuAdmin"
                    aria-controls="menuAdmin"
                    aria-expanded="false"
                    aria-label="Abrir menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="menuAdmin" class="collapse navbar-collapse">
                <div class="navbar-nav admin-nav-links me-auto">

                    <a class="nav-link"
                       asp-area="Admin"
                       asp-controller="Admin"
                       asp-action="Index">
                        <i class="bi bi-house-door"></i>
                        Início
                    </a>

                    <a class="nav-link"
                       asp-area="Admin"
                       asp-controller="AdminLivros"
                       asp-action="Index">
                        <i class="bi bi-book"></i>
                        Livros
                    </a>

                    <a class="nav-link"
                       asp-area="Admin"
                       asp-controller="AdminAutores"
                       asp-action="Index">
                        <i class="bi bi-person-lines-fill"></i>
                        Autores
                    </a>

                    <a class="nav-link"
                       asp-area="Admin"
                       asp-controller="AdminCategorias"
                       asp-action="Index">
                        <i class="bi bi-tags"></i>
                        Categorias
                    </a>

                    <a class="nav-link"
                       asp-area="Admin"
                       asp-controller="AdminEditoras"
                       asp-action="Index">
                        <i class="bi bi-building"></i>
                        Editoras
                    </a>

                    <a class="nav-link"
                       asp-area="Admin"
                       asp-controller="AdminExemplares"
                       asp-action="Index">
                        <i class="bi bi-journals"></i>
                        Exemplares
                    </a>

                    <a class="nav-link"
                       asp-area="Admin"
                       asp-controller="AdminUsuarios"
                       asp-action="Index">
                        <i class="bi bi-people"></i>
                        Usuários
                    </a>

                    <a class="nav-link"
                       asp-area="Admin"
                       asp-controller="AdminEmprestimos"
                       asp-action="Index">
                        <i class="bi bi-arrow-left-right"></i>
                        Empréstimos
                    </a>
                </div>

                <form asp-area=""
                      asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="admin-sair-form">

                    <button type="submit" class="btn admin-btn-sair">
                        <i class="bi bi-box-arrow-right"></i>
                        Sair
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <main class="container pb-5">

        @if (TempData["Mensagem"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">
                @TempData["Mensagem"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Fechar">
                </button>
            </div>
        }

        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show"
                 role="alert">
                @TempData["Erro"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Fechar">
                </button>
            </div>
        }

        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
