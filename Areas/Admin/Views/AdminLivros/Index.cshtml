
@model IEnumerable<Biblioteca.Models.Livro>

@{
    ViewData["Title"] = "Livros";
}

<div class="admin-dashboard">

    <div class="admin-cabecalho mb-4">
        <div>
            <h1>Livros</h1>
            <p class="text-muted mb-0">
                    Consulte livros cadastrados.
                </p>
        </div>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i>
            Novo livro
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Título</th>
                            <th>ISBN</th>
                            <th>Ano</th>
                            <th class="text-end pe-3">Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <span class="fw-semibold">@item.Titulo</span>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.ISBN)
                                            ? "—"
                                            : item.ISBN)
                                    </td>

                                    <td>@item.AnoPublicacao</td>

                                    <td class="text-end pe-3">
                                        <div class="d-flex justify-content-end flex-wrap gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="Detalhes">
                                                <i class="bi bi-eye"></i>
                                                <span class="d-none d-md-inline">Detalhes</span>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar">
                                                <i class="bi bi-pencil-square"></i>
                                                <span class="d-none d-md-inline">Editar</span>
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Excluir">
                                                <i class="bi bi-trash"></i>
                                                <span class="d-none d-md-inline">Excluir</span>
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4">
                                    <i class="bi bi-journal-x fs-3 text-muted"></i>
                                    <p class="mt-2 mb-0">Nenhum livro cadastrado.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>

</div>
