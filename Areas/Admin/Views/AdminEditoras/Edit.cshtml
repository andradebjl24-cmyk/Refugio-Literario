@model Biblioteca.Models.Editora

@{
    ViewData["Title"] = "Editar editora";
}

<div class="admin-dashboard">

    <div class="admin-cabecalho mb-4">
        <div>
            <h1>Editar editora</h1>
        </div>

        <div class="admin-cabecalho-icone">
            <i class="bi bi-building"></i>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label">
                        Nome da editora
                    </label>

                    <input asp-for="Nome" class="form-control" />

                    <span asp-validation-for="Nome"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CNPJ" class="form-label">
                        CNPJ
                    </label>

                    <input asp-for="CNPJ" class="form-control" />

                    <span asp-validation-for="CNPJ"
                          class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label asp-for="Cidade" class="form-label">
                            Cidade
                        </label>

                        <input asp-for="Cidade" class="form-control" />

                        <span asp-validation-for="Cidade"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Estado" class="form-label">
                            Estado
                        </label>

                        <input asp-for="Estado" class="form-control" />

                        <span asp-validation-for="Estado"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>
                        Salvar alterações
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Voltar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
