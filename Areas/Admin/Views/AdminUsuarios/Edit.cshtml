@model Biblioteca.ViewModels.AdminUsuarioViewModel

@{
    ViewData["Title"] = "Editar Usuário";
}

<div class="admin-dashboard">

    <div class="admin-cabecalho d-flex align-items-center gap-3 mb-4">
        <div class="admin-cabecalho-icone">
            <i class="bi bi-person-gear"></i>
        </div>
        <div>
            <h1 class="mb-1">Editar Usuário</h1>
            <p class="text-muted mb-0">
                Atualize os dados e as permissões da conta.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <partial name="_CamposUsuario" model="Model" />

                <hr class="my-4" />

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg me-1"></i>
                        Salvar alterações
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-1"></i>
                        Cancelar
                    </a>
                </div>
            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

