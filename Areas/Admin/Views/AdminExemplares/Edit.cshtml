@model Biblioteca.Models.Exemplar

@{
    ViewData["Title"] = "Editar Exemplar";
}

<div class="admin-dashboard">

    <div class="admin-cabecalho d-flex align-items-center gap-3 mb-4">
        <div class="admin-cabecalho-icone">
            <i class="bi bi-book-half"></i>
        </div>
        <div>
            <h1 class="mb-1">Editar Exemplar</h1>
            <p class="text-muted mb-0">Atualize as informações do exemplar.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Tombo" class="form-label">Tombo</label>
                    <input asp-for="Tombo" class="form-control" />
                    <span asp-validation-for="Tombo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<Biblioteca.Models.StatusExemplar>()"
                            class="form-select">
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg me-1"></i>
                        Salvar alterações
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Voltar
                    </a>
                </div>
            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
