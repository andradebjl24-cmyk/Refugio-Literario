@model List<Biblioteca.Models.Livro>

@{
    ViewData["Title"] = "Buscar livros";

    var livrosFavoritos = ViewBag.LivrosFavoritos
        as HashSet<int> ?? new HashSet<int>();

    string termo = ViewBag.Termo as string ?? "";
}

<section class="pagina-busca secao-todos-livros">
    <div class="container">

        <div class="secao-titulo">
            <h2>Buscar livros</h2>
            <p>Encontre sua próxima aventura entre nossas páginas.</p>
        </div>

        <!-- CAMPO DE BUSCA -->
        <form asp-controller="Livro"
              asp-action="Buscar"
              method="get"
              class="formulario-busca filtros-todos-livros">

            <div class="campo-filtro campo-pesquisa">
                <label for="termo">Título do livro ou nome do autor</label>

                <input type="text"
                       id="termo"
                       name="termo"
                       value="@termo"
                       placeholder="Digite um título ou autor..."
                       aria-label="Buscar por título ou autor" />
            </div>

            <div class="botoes-filtros">
                <button type="submit" class="botao-filtrar-livros">
                    <i class="bi bi-search"></i>
                    Buscar
                </button>

                <a asp-controller="Livro"
                   asp-action="Buscar"
                   class="botao-limpar-filtros">
                    Limpar busca
                </a>
            </div>
        </form>

        @if (Model.Any())
        {
            <div class="resultado-livros">
                <span>
                    <i class="bi bi-book-half"></i>
                    @Model.Count livro(s) encontrado(s)

                    @if (!string.IsNullOrWhiteSpace(termo))
                    {
                        <span> para "@termo"</span>
                    }
                </span>
            </div>

            <div class="lista-todos-livros">

                @foreach (var livro in Model)
                {
                    var jaFavoritado = livrosFavoritos.Contains(livro.Id);

                    <article class="livro-todos-card">

                        <!-- CAPA -->
                        <div class="livro-todos-capa">

                            @if (!string.IsNullOrWhiteSpace(livro.Imagem))
                            {
                                <img src="@Url.Content(
                                    livro.Imagem.StartsWith("/")
                                        ? livro.Imagem
                                        : "~/" + livro.Imagem.TrimStart('~', '/'))"
                                     alt="Capa do livro @livro.Titulo"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="livro-todos-sem-capa">
                                    <i class="bi bi-book"></i>
                                    <span>Sem capa disponível</span>
                                </div>
                            }

                            @if (livro.Destaque)
                            {
                                <span class="selo-destaque">
                                    <i class="bi bi-stars"></i>
                                    Destaque
                                </span>
                            }
                        </div>

                        <!-- INFORMAÇÕES -->
                        <div class="livro-todos-info">

                            <h3 title="@livro.Titulo">
                                @livro.Titulo
                            </h3>

                            <p class="livro-todos-autor">
                                <i class="bi bi-person"></i>

                                @if (livro.LivrosAutores != null &&
                                     livro.LivrosAutores.Any(la => la.Autor != null))
                                {
                                    @string.Join(", ",
                                        livro.LivrosAutores
                                            .Where(la => la.Autor != null)
                                            .Select(la => la.Autor!.Nome))
                                }
                                else
                                {
                                    <span>Autor não informado</span>
                                }
                            </p>

                            @if (livro.Categoria != null)
                            {
                                <span class="livro-todos-categoria">
                                    @livro.Categoria.Nome
                                </span>
                            }

                            <div class="livro-todos-detalhes">
                                <span>
                                    <i class="bi bi-calendar3"></i>
                                    @livro.AnoPublicacao
                                </span>

                                <span>
                                    <i class="bi bi-journal-bookmark"></i>
                                    @(livro.Exemplares?.Count(e =>
                                        e.Status == Biblioteca.Models.StatusExemplar.Disponivel) ?? 0)
                                    disponível(is)
                                </span>
                            </div>

                            <div class="livro-todos-acoes">

                                <a asp-controller="Livro"
                                   asp-action="Details"
                                   asp-route-id="@livro.Id"
                                   class="livro-todos-link">
                                    Ver detalhes
                                    <i class="bi bi-arrow-right"></i>
                                </a>

                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form asp-controller="Livro"
                                          asp-action="Favoritar"
                                          method="post"
                                          class="form-favoritar-catalogo">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="livroId"
                                               value="@livro.Id" />

                                        <button type="submit"
                                                class="livro-todos-favorito @(jaFavoritado ? "favoritado" : "")"
                                                title="@(jaFavoritado ? "Remover dos favoritos" : "Adicionar aos favoritos")"
                                                aria-label="@(jaFavoritado ? "Remover dos favoritos" : "Adicionar aos favoritos")">

                                            <i class="bi @(jaFavoritado ? "bi-heart-fill" : "bi-heart")"></i>
                                        </button>
                                    </form>
                                }

                            </div>
                        </div>
                    </article>
                }

            </div>
        }
        else if (!string.IsNullOrWhiteSpace(termo))
        {
            <div class="livros-sem-resultados">
                <i class="bi bi-journal-x"></i>
                <h3>Nenhum livro encontrado</h3>
                <p>
                    Não encontramos livros para
                    <strong>"@termo"</strong>.
                    Tente pesquisar pelo título ou pelo nome do autor.
                </p>

                <a asp-controller="Livro"
                   asp-action="Index"
                   class="botao-filtrar-livros">
                    Ver todos os livros
                </a>
            </div>
        }
        else
        {
            <div class="livros-sem-resultados">
                <i class="bi bi-book"></i>
                <h3>Qual história vamos descobrir?</h3>
                <p>Digite o título de um livro ou o nome de um autor para começar.</p>
            </div>
        }

    </div>
</section>
