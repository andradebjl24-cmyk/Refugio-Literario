
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject Biblioteca.Data.BibliotecaContext Db

@{
    var categoriasNav = await Db.Categorias
        .AsNoTracking()
        .OrderBy(c => c.Nome)
        .ToListAsync();
}

<!doctype html>
<html lang="pt-br">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>@ViewData["Title"] - Refúgio Literário</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Ícones -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- CSS principal -->
    <link rel="stylesheet"
          href="~/css/biblioteca.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@(ViewData["PaginaInicial"] != null ? "pagina-inicial" : "")">

    <nav class="biblioteca-navbar" aria-label="Navegação principal">

        <div class="biblioteca-navbar-conteudo">

            <!-- LINHA PRINCIPAL: LOGO, PESQUISA E MENU -->

            <div class="biblioteca-navbar-topo">

             <!-- LOGO: voltar para a página inicial -->

<a class="biblioteca-logo"
asp-area=""
asp-controller="Home"
asp-action="Index"
aria-label="Ir para a página inicial">

<img src="~/images/logo.png"
     alt="Refúgio Literário"
     class="biblioteca-logo-img" />

</a>

            

                <!-- BARRA DE PESQUISA -->

                <form asp-area=""
                      asp-controller="Livro"
                      asp-action="Buscar"
                      method="get"
                      class="biblioteca-busca"
                      role="search">

                    <input type="search"
                           name="termo"
                           value="@Context.Request.Query["termo"]"
                           placeholder="Buscar livros..."
                           aria-label="Buscar livros">

                    <button type="submit" title="Buscar livros" aria-label="Buscar livros">
                        <i class="bi bi-search" aria-hidden="true"></i>
                    </button>

                </form>

                <!-- BOTÃO DO MENU HAMBÚRGUER -->

                <button class="biblioteca-menu-toggle"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir ou fechar o menu">

                    <i class="bi bi-list" aria-hidden="true"></i>

                </button>

            </div>

            <!-- MENU EXPANSÍVEL -->

            <div class="collapse biblioteca-menu-colapsavel"
                 id="menuPrincipal">

                <div class="biblioteca-nav-direita">

                    <!-- TODOS OS LIVROS -->

                    <a class="btn biblioteca-btn-entrar"
                       asp-area=""
                       asp-controller="Livro"
                       asp-action="Index">

                        <i class="bi bi-book" aria-hidden="true"></i>
                        Todos os livros
                    </a>

                    <!-- CATEGORIAS -->

                    <div class="dropdown biblioteca-dropdown-categorias">

                        <button class="btn biblioteca-btn-entrar dropdown-toggle"
                                type="button"
                                id="menuCategorias"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <i class="bi bi-bookmark" aria-hidden="true"></i>
                            Categorias
                        </button>

                        <ul class="dropdown-menu biblioteca-menu-categorias"
                            aria-labelledby="menuCategorias">

                            @if (categoriasNav.Any())
                            {
                                @foreach (var categoria in categoriasNav)
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-controller="Livro"
                                           asp-action="Categoria"
                                           asp-route-id="@categoria.Id">

                                            @categoria.Nome
                                        </a>
                                    </li>
                                }
                            }
                            else
                            {
                                <li>
                                    <span class="dropdown-item-text">
                                        Nenhuma categoria cadastrada.
                                    </span>
                                </li>
                            }

                        </ul>

                    </div>

                    <!-- OPÇÕES PARA USUÁRIOS LOGADOS -->

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn biblioteca-btn-perfil"
                           asp-area=""
                           asp-controller="Account"
                           asp-action="Perfil">

                            <i class="bi bi-person-circle" aria-hidden="true"></i>
                            Meu perfil
                        </a>

                        <a class="btn biblioteca-btn-favoritos"
                           asp-area=""
                           asp-controller="Account"
                           asp-action="Favoritos">

                            <i class="bi bi-heart" aria-hidden="true"></i>
                            Meus favoritos
                        </a>

                        <a class="btn biblioteca-btn-emprestimos"
                           asp-area=""
                           asp-controller="Account"
                           asp-action="Emprestimos">

                            <i class="bi bi-journal-bookmark" aria-hidden="true"></i>
                            Meus empréstimos
                        </a>

                        <!-- ACESSO EXCLUSIVO DO ADMINISTRADOR -->

                        @if (User.IsInRole("Administrador"))
                        {
                            <a class="btn biblioteca-btn-admin"
                               asp-area="Admin"
                               asp-controller="Admin"
                               asp-action="Index">

                                <i class="bi bi-shield-lock" aria-hidden="true"></i>
                                Painel administrativo
                            </a>
                        }

                        <!-- SAIR -->

                        <form asp-area=""
                              asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="biblioteca-form-sair">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn biblioteca-btn-sair">

                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                Sair
                            </button>

                        </form>
                    }
                    else
                    {
                        <!-- OPÇÕES PARA VISITANTES -->

                        <a class="btn biblioteca-btn-entrar"
                           asp-area=""
                           asp-controller="Account"
                           asp-action="Login">

                            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                            Entrar
                        </a>

                        <a class="btn biblioteca-btn-cadastrar"
                           asp-area=""
                           asp-controller="Account"
                           asp-action="Cadastro">

                            <i class="bi bi-person-plus" aria-hidden="true"></i>
                            Cadastrar-se
                        </a>
                    }

                </div>

            </div>

        </div>

    </nav>

    <!-- CONTEÚDO DA PÁGINA -->

    <main>
        @RenderBody()
    </main>

    <!-- Bootstrap JavaScript: necessário para abrir o menu -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
